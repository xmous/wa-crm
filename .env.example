# ==============================================================================
# WA-CRM Pro - Production Environment Configuration Template
# ==============================================================================

# Server Port
PORT=3000

# PostgreSQL Database Connection URL
# Format: postgresql://[user]:[password]@[host]:[port]/[database]?schema=public
DATABASE_URL="postgresql://postgres:password123@localhost:5432/waweb?schema=public"

# JWT Secret Key (Gunakan kunci rahasia yang panjang, unik, dan acak untuk produksi)
JWT_SECRET="ganti_dengan_kunci_rahasia_jwt_produksi_yang_panjang_dan_aman_min_32_karakter"

# Anti-Ban Jitter Engine Parameters (Milidetik)
ANTI_BAN_MIN_DELAY=8000
ANTI_BAN_MAX_DELAY=22000
ANTI_BAN_BATCH_SIZE=20
ANTI_BAN_COOLDOWN_MS=60000

# Optional AI Engine Integrations (Opsional jika ingin fitur AI Auto-Responder)
OPENAI_API_KEY=""
GEMINI_API_KEY=""
